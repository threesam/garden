{
 "name": "threesam",
 "version": "0.1.0",
 "private": true,
 "type": "module",
 "scripts": {
  "dev": "vite dev",
  "build": "vite build",
  "preview": "vite preview",
  "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
  "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
  "test": "vitest run",
  "test:visual": "playwright test tests/visual.spec.ts",
  "test:smoke": "playwright test tests/routes.spec.ts",
  "lint": "eslint .",
  "wasm:build": "cargo build --manifest-path rust/garden_math/Cargo.toml --target wasm32-unknown-unknown --release && cp rust/garden_math/target/wasm32-unknown-unknown/release/garden_math.wasm static/wasm/garden_math.wasm",
  "bake:deana": "node scripts/generate-deana-ascii.mjs",
  "bake:deana-matrix": "node scripts/generate-deana-ascii-matrix.mjs",
  "bake:thoughts": "node scripts/generate-thoughts-pixel.mjs",
  "sounds:ingest": "node scripts/sounds/ingest.mjs",
  "sounds:deploy": "node scripts/sounds/deploy-r2.mjs",
  "lh": "node scripts/lighthouse.mjs",
  "test:watch": "vitest",
  "test:e2e": "playwright test"
 },
 "devDependencies": {
  "@eslint/js": "10.0.1",
  "@playwright/test": "1.63.0",
  "@sveltejs/adapter-vercel": "6.3.4",
  "@sveltejs/kit": "2.70.3",
  "@sveltejs/vite-plugin-svelte": "7.3.1",
  "@tailwindcss/postcss": "4.3.3",
  "@tailwindcss/vite": "4.3.3",
  "@types/d3-cloud": "1.2.9",
  "@types/node": "26.6.2",
  "@types/three": "0.186.0",
  "chrome-launcher": "1.2.1",
  "eslint": "10.11.0",
  "eslint-plugin-svelte": "3.23.0",
  "globals": "17.12.0",
  "lighthouse": "13.5.0",
  "svelte": "5.57.1",
  "svelte-check": "4.7.6",
  "tailwindcss": "4.3.3",
  "typescript": "6.0.3",
  "typescript-eslint": "8.70.1",
  "vite": "8.3.0",
  "vitest": "5.0.1",
  "wrangler": "4.137.0"
 },
 "pnpm": {
  "onlyBuiltDependencies": [
   "esbuild",
   "sharp"
  ]
 },
 "dependencies": {
  "@fontsource-variable/recursive": "5.3.0",
  "@fontsource/epilogue": "5.3.0",
  "@fontsource/michroma": "5.3.0",
  "chart.js": "4.5.1",
  "d3-cloud": "1.2.9",
  "fast-xml-parser": "5.11.1",
  "marked": "18.0.14",
  "marked-emoji": "3.0.0",
  "node-emoji": "2.2.0",
  "sharp": "0.35.4",
  "three": "0.186.0"
 }
}
